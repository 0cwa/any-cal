# Copy to a user-owned configuration location and edit without committing secrets.
endpoint=http://127.0.0.1:31009
api_version=2025-11-08
space_id=REQUIRED_SPACE_ID
contacts_collection=contacts
tasks_collection=tasks
listen_address=127.0.0.1:8080
max_connections=64
# Prefer ANY_CAL_ANYTYPE_TOKEN in the process environment; do not store it here.
# Set ANY_CAL_LOCAL_AUTH only in the GUI/service environment for protected health checks.
